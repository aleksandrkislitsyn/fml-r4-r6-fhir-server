/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/Address6to4'
/// name = 'Address6to4'
/// title = 'Address Transforms: R6 to R4'
/// status = 'draft'

// Generated by reversing Address_4to6.fml. R6-only elements of this type have no R4 place.
uses "http://hl7.org/fhir/6.0/StructureDefinition/Address" alias AddressR6 as source
uses "http://hl7.org/fhir/4.0/StructureDefinition/Address" alias AddressR4 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*6to4"


group Address(source src : AddressR6, target tgt : AddressR4) extends Element <<type+>> {
  src.use -> tgt.use;
  src.type -> tgt.type;
  src.text -> tgt.text;
  src.line -> tgt.line;
  src.city -> tgt.city;
  src.district -> tgt.district;
  src.state -> tgt.state;
  src.postalCode -> tgt.postalCode;
  src.country -> tgt.country;
  src.period -> tgt.period;
}
