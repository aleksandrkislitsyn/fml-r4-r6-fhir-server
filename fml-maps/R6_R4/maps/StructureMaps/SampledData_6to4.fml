/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/SampledData6to4'
/// name = 'SampledData6to4'
/// title = 'SampledData Transforms: R6 to R4'
/// status = 'draft'

// Generated by reversing SampledData_4to6.fml. R6-only elements of this type have no R4 place.
uses "http://hl7.org/fhir/6.0/StructureDefinition/SampledData" alias SampledDataR6 as source
uses "http://hl7.org/fhir/4.0/StructureDefinition/SampledData" alias SampledDataR4 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*6to4"

group SampledData(source src : SampledDataR6, target tgt : SampledDataR4) extends Element <<type+>> {
  src.origin -> tgt.origin;
  src.interval -> tgt.period;
  src.factor -> tgt.factor;
  src.lowerLimit -> tgt.lowerLimit;
  src.upperLimit -> tgt.upperLimit;
  src.dimensions -> tgt.dimensions;
  src.data -> tgt.data;
}
