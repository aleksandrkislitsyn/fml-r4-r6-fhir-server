uses "http://hl7.org/fhir/4.0/StructureDefinition/time" alias timeR4 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*6to4"


group Time(source src : timeR6, target tgt : timeR4) extends Element <<type+>> {
