// Generated by reversing Period_4to6.fml. R6-only elements of this type have no R4 place.
uses "http://hl7.org/fhir/6.0/StructureDefinition/Period" alias PeriodR6 as source
uses "http://hl7.org/fhir/4.0/StructureDefinition/Period" alias PeriodR4 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*6to4"


group Period(source src : PeriodR6, target tgt : PeriodR4) extends Element <<type+>> {
  src.start -> tgt.start;
  src.end -> tgt.end;
}
