/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/Identifier6to4'
/// name = 'Identifier6to4'
/// title = 'Identifier Transforms: R6 to R4'
/// status = 'draft'

// Generated by reversing Identifier_4to6.fml. R6-only elements of this type have no R4 place.
uses "http://hl7.org/fhir/6.0/StructureDefinition/Identifier" alias IdentifierR6 as source
uses "http://hl7.org/fhir/4.0/StructureDefinition/Identifier" alias IdentifierR4 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*6to4"


group Identifier(source src : IdentifierR6, target tgt : IdentifierR4) extends Element <<type+>> {
  src.use -> tgt.use;
  src.type -> tgt.type;
  src.system -> tgt.system;
  src.value -> tgt.value;
  src.period -> tgt.period;
  src.assigner -> tgt.assigner;
}
