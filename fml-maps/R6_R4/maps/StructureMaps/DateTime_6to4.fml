uses "http://hl7.org/fhir/6.0/StructureDefinition/dateTime" alias dateTimeR6 as source
uses "http://hl7.org/fhir/4.0/StructureDefinition/dateTime" alias dateTimeR4 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*6to4"


group DateTime(source src : dateTimeR6, target tgt : dateTimeR4) extends Element <<type+>> {
