// Generated by reversing BackboneElement_4to6.fml. R6-only elements of this type have no R4 place.
uses "http://hl7.org/fhir/6.0/StructureDefinition/BackboneElement" alias BackboneElementR6 as source
uses "http://hl7.org/fhir/4.0/StructureDefinition/BackboneElement" alias BackboneElementR4 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*6to4"


group BackboneElement(source src : BackboneElementR6, target tgt : BackboneElementR4) extends Element <<type+>> {
  src.modifierExtension where (url.startsWith('http://hl7.org/fhir/5.0/StructureDefinition/extension-').not()) -> tgt.modifierExtension;
}
