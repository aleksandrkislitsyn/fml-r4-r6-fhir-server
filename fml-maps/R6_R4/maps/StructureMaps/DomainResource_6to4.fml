/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/DomainResource6to4'
/// name = 'DomainResource6to4'
/// title = 'DomainResource Transforms: R6 to R4'
/// status = 'draft'

uses "http://hl7.org/fhir/6.0/StructureDefinition/DomainResource" alias DomainResourceR6 as source
uses "http://hl7.org/fhir/4.0/StructureDefinition/DomainResource" alias DomainResourceR4 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*6to4"


// contained, implicitRules and modifierExtension are rejected before mapping, in
// src/http/r6writes.ts, so they never reach this map.
group DomainResource(source src : DomainResourceR6, target tgt : DomainResourceR4) extends Resource <<type+>> {
  src.text -> tgt.text;
  src.extension where (url.startsWith('http://hl7.org/fhir/5.0/StructureDefinition/extension-').not()) -> tgt.extension;
}
