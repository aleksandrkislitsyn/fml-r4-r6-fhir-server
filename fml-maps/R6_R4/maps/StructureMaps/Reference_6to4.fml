/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/Reference6to4'
/// name = 'Reference6to4'
/// title = 'Reference Transforms: R6 to R4'
/// status = 'draft'

// Generated by reversing Reference_4to6.fml. R6-only elements of this type have no R4 place.
uses "http://hl7.org/fhir/6.0/StructureDefinition/Reference" alias ReferenceR6 as source
uses "http://hl7.org/fhir/4.0/StructureDefinition/Reference" alias ReferenceR4 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*6to4"


group Reference(source src : ReferenceR6, target tgt : ReferenceR4) extends Element <<type+>> {
  src.reference.value -> tgt.reference.value;
  src.type -> tgt.type;
  src.identifier -> tgt.identifier;
  src.display -> tgt.display;
}
