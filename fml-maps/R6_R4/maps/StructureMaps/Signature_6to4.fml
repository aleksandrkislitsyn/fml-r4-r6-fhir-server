uses "http://hl7.org/fhir/4.0/StructureDefinition/Signature" alias SignatureR4 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*6to4"


group Signature(source src : SignatureR6, target tgt : SignatureR4) extends Element <<type+>> {
