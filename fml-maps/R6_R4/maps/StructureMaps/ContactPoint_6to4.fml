uses "http://hl7.org/fhir/4.0/StructureDefinition/ContactPoint" alias ContactPointR4 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*6to4"


group ContactPoint(source src : ContactPointR6, target tgt : ContactPointR4) extends Element <<type+>> {
