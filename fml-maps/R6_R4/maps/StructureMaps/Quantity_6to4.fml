/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/Quantity6to4'
/// name = 'Quantity6to4'
/// title = 'Quantity Transforms: R6 to R4'
/// status = 'draft'

// Generated by reversing Quantity_4to6.fml. R6-only elements of this type have no R4 place.
uses "http://hl7.org/fhir/6.0/StructureDefinition/Quantity" alias QuantityR6 as source
uses "http://hl7.org/fhir/4.0/StructureDefinition/Quantity" alias QuantityR4 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*6to4"


group Quantity(source src : QuantityR6, target tgt : QuantityR4) extends Element <<type+>> {
  src.value -> tgt.value;
  // R6 added ~ and ad, which have no R4 code (required binding). They are left out, so a
  // write that uses them fails the round-trip check and returns 422.
  // TODO: no R4 mapping; intended handling is the R6 code in a cross-version extension plus
  // implicitRules on the resource, as for Encounter.status discontinued.
  src.comparator where ($this = '<' or $this = '<=' or $this = '>=' or $this = '>') -> tgt.comparator;
  src.unit -> tgt.unit;
  src.system -> tgt.system;
  src.code -> tgt.code;
}
