/// url = 'http://example.org/fhir/StructureMap/BodyStructure6to4'
/// name = 'BodyStructure6to4'
/// title = 'BodyStructure Transforms: R6 to R4 (one R4 row per includedStructure)'
/// status = 'draft'

uses "http://hl7.org/fhir/6.0/StructureDefinition/BodyStructure" alias BodyStructureR6 as source
uses "http://hl7.org/fhir/StructureDefinition/Bundle" alias Bundle as target

// R6 includedStructure is 1..*, but R4 location and morphology are 0..1, so each
// structure becomes its own R4 BodyStructure. HL7 does not define this split; it is
// this project's design. Row ids, row links and meta are set in src/fhir/convert.ts and
// src/fhir/bodystructure.ts.
//
// Style required by fhir-structuremap-js (see src/fhir/fml.ts): copy with
// "as v -> tgt.x = v", and add to a repeating element with "= create(...)".
group BodyStructureSplit(source src : BodyStructureR6, target bundle : Bundle) {
  src -> bundle.type = 'collection' "type";
  src.includedStructure as inc -> bundle.entry = create('BackboneElement') as e, e.resource = create('BodyStructure') as out then BodyStructureRow(src, inc, out) "entry";
}

group BodyStructureRow(source src, source inc, target out) {
  src -> out.resourceType = 'BodyStructure' "resourceType";

  // Shared fields: on every row, and kept in sync by src/fhir/bodystructure.ts.
  src.language as v -> out.language = v "language";
  src.text as v -> out.text = v "text";
  src.identifier as v -> out.identifier = v "identifier";
  src.active as v -> out.active = v "active";
  src.description as v -> out.description = v "description";
  src.image as a -> out.image = create('Attachment') as t then AttachmentToR4(a, t) "image";
  src.patient as v -> out.patient = v "patient";

  // excludedStructure says what is NOT there. It must never become a row of its own,
  // because a row reads as a structure that is present. It is shared, so deleting a row
  // can't lose it.
  src.excludedStructure as ex -> out.extension = create('Extension') as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-BodyStructure.excludedStructure' then StructureToExtension(ex, x) "excluded";

  // Extensions on the R6 resource describe all of it, so they are shared. A wrapper keeps
  // them apart from a structure's own extensions, which sit directly on its row.
  src.extension as e -> out.extension = create('Extension') as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-BodyStructure.extension', x.extension = e "sharedExtension";

  // Per-row fields.
  inc.structure as v -> out.location = v "location";
  inc.morphology first as v -> out.morphology = v "morphology";

  // R4 morphology holds one value: the rest are kept in an extension.
  inc.morphology not_first as v -> out.extension = create('Extension') as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-BodyStructure.includedStructure.morphology', x.valueCodeableConcept = v "morphologyExtra";

  // laterality and qualifier both land in locationQualifier. A marker on the laterality
  // item lets the read path put it back, and it disappears if an R4 client removes the item.
  inc.qualifier as v -> out.locationQualifier = v "qualifier";
  inc.laterality as v -> out.locationQualifier = create('CodeableConcept') as q then MarkLaterality(v, q) "laterality";

  inc then StructureExtras(inc, out) "extras";
}

group MarkLaterality(source v, target q) {
  v.coding as c -> q.coding = c "coding";
  v.text as t -> q.text = t "text";
  v -> q.extension = create('Extension') as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-BodyStructure.includedStructure.laterality', x.valueBoolean = true "marker";
}

// Elements with no R4 element. Used on a row, and inside the excludedStructure extension.
group StructureExtras(source inc, target out) {
  inc.extension as e -> out.extension = e "extension";
  inc.bodyLandmarkOrientation as lm -> out.extension = create('Extension') as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-BodyStructure.includedStructure.bodyLandmarkOrientation' then LandmarkToExtension(lm, x) "landmark";
  inc.spatialReference as v -> out.extension = create('Extension') as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-BodyStructure.includedStructure.spatialReference', x.valueReference = v "spatialReference";
  inc.image as a -> out.extension = create('Extension') as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-BodyStructure.includedStructure.image', x.valueAttachment = create('Attachment') as t then AttachmentToR4(a, t) "image";
  inc.origin as v -> out.extension = create('Extension') as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-BodyStructure.includedStructure.origin', x.valueCodeableConcept = v "origin";
}

// A whole structure as extensions: all of it goes here, since nothing has an R4 element.
group StructureToExtension(source ex, target x) {
  ex.structure as v -> x.extension = create('Extension') as e, e.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-BodyStructure.includedStructure.structure', e.valueCodeableConcept = v "structure";
  ex.laterality as v -> x.extension = create('Extension') as e, e.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-BodyStructure.includedStructure.laterality', e.valueCodeableConcept = v "laterality";
  ex.qualifier as v -> x.extension = create('Extension') as e, e.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-BodyStructure.includedStructure.qualifier', e.valueCodeableConcept = v "qualifier";
  ex.morphology as v -> x.extension = create('Extension') as e, e.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-BodyStructure.includedStructure.morphology', e.valueCodeableConcept = v "morphology";
  ex then StructureExtras(ex, x) "extras";
}

group LandmarkToExtension(source lm, target x) {
  lm.landmarkDescription as v -> x.extension = create('Extension') as e, e.url = 'landmarkDescription', e.valueCodeableConcept = v "landmarkDescription";
  lm.clockFacePosition as v -> x.extension = create('Extension') as e, e.url = 'clockFacePosition', e.valueCodeableConcept = v "clockFacePosition";
  lm.distanceFromLandmark as d -> x.extension = create('Extension') as e, e.url = 'distanceFromLandmark' then DistanceToExtension(d, e) "distanceFromLandmark";
  lm.surfaceOrientation as v -> x.extension = create('Extension') as e, e.url = 'surfaceOrientation', e.valueCodeableConcept = v "surfaceOrientation";
}

group DistanceToExtension(source d, target x) {
  d.device as dv -> x.extension = create('Extension') as e, e.url = 'device' then CodeableReferenceToExtension(dv, e) "device";
  d.value as v -> x.extension = create('Extension') as e, e.url = 'value', e.valueQuantity = v "value";
}

group CodeableReferenceToExtension(source c, target x) {
  c.concept as v -> x.extension = create('Extension') as e, e.url = 'concept', e.valueCodeableConcept = v "concept";
  c.reference as v -> x.extension = create('Extension') as e, e.url = 'reference', e.valueReference = v "reference";
}

// R6 Attachment has fields R4 lacks, and size changes from integer64 (a JSON string)
// to unsignedInt (a number). A size R4 can't hold fails R4 validation, so it is rejected.
group AttachmentToR4(source a, target t) {
  a.extension as e -> t.extension = e "extension";
  a.contentType as v -> t.contentType = v "contentType";
  a.language as v -> t.language = v "language";
  a.data as v -> t.data = v "data";
  a.url as v -> t.url = v "url";
  a.size as v -> t.size = evaluate(v, $this.toInteger()) "size";
  a.hash as v -> t.hash = v "hash";
  a.title as v -> t.title = v "title";
  a.creation as v -> t.creation = v "creation";
  a.height as v -> t.extension = create('Extension') as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-Attachment.height', x.valuePositiveInt = v "height";
  a.width as v -> t.extension = create('Extension') as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-Attachment.width', x.valuePositiveInt = v "width";
  a.frames as v -> t.extension = create('Extension') as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-Attachment.frames', x.valuePositiveInt = v "frames";
  a.duration as v -> t.extension = create('Extension') as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-Attachment.duration', x.valueDecimal = v "duration";
  a.pages as v -> t.extension = create('Extension') as x, x.url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-Attachment.pages', x.valuePositiveInt = v "pages";
}
