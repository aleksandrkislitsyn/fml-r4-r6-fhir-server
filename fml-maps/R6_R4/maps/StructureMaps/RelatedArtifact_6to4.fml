// Generated by reversing RelatedArtifact_4to6.fml. R6-only elements of this type have no R4 place.
uses "http://hl7.org/fhir/6.0/StructureDefinition/RelatedArtifact" alias RelatedArtifactR6 as source
uses "http://hl7.org/fhir/4.0/StructureDefinition/RelatedArtifact" alias RelatedArtifactR4 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*6to4"

group RelatedArtifact(source src : RelatedArtifactR6, target tgt : RelatedArtifactR4) extends Element <<type+>> {
  src.type -> tgt.type;
  src.label -> tgt.label;
  src.display -> tgt.display;
  src.citation -> tgt.citation;
  src.document -> tgt.document;
  src.resource -> tgt.resource;
}
