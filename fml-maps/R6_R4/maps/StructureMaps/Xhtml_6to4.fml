/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/xhtml6to4'
/// name = 'xhtml6to4'
/// title = 'xhtml Transforms: R6 to R4'
/// status = 'draft'

// Generated by reversing Xhtml_4to6.fml. R6-only elements of this type have no R4 place.
uses "http://hl7.org/fhir/6.0/StructureDefinition/xhtml" alias xhtmlR6 as source
uses "http://hl7.org/fhir/4.0/StructureDefinition/xhtml" alias xhtmlR4 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*6to4"


group Xhtml(source src : xhtmlR6, target tgt : xhtmlR4) extends Element <<type+>> {
  src.value -> tgt.value;
}
