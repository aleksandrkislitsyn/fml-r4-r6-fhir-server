/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/Dosage6to4'
/// name = 'Dosage6to4'
/// title = 'Dosage Transforms: R6 to R4'
/// status = 'draft'

// Generated by reversing Dosage_4to6.fml. R6-only elements of this type have no R4 place.
uses "http://hl7.org/fhir/6.0/StructureDefinition/Dosage" alias DosageR6 as source
uses "http://hl7.org/fhir/4.0/StructureDefinition/Dosage" alias DosageR4 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*6to4"

group Dosage(source src : DosageR6, target tgt : DosageR4) extends BackboneElement <<type+>> {
  src.text -> tgt.text;
  src.additionalInstruction -> tgt.additionalInstruction;
  src.patientInstruction -> tgt.patientInstruction;
  src.timing -> tgt.timing;
  src.asNeeded : boolean -> tgt.asNeeded;
  src.site -> tgt.site;
  src.route -> tgt.route;
  src.method -> tgt.method;
  src.doseAndRate as s -> tgt.doseAndRate as t then DosageDoseAndRate(s, t);
}


group DosageDoseAndRate(source src, target tgt) extends Element {
  src.type -> tgt.type;
  src.dose -> tgt.dose;
  src.rate -> tgt.rate;
}
