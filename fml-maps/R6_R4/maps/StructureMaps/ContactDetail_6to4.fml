uses "http://hl7.org/fhir/4.0/StructureDefinition/ContactDetail" alias ContactDetailR4 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*6to4"


group ContactDetail(source src : ContactDetailR6, target tgt : ContactDetailR4) extends Element <<type+>> {
  src.name -> tgt.name;
