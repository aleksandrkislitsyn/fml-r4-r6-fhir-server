uses "http://hl7.org/fhir/6.0/StructureDefinition/Timing" alias TimingR6 as source
uses "http://hl7.org/fhir/4.0/StructureDefinition/Timing" alias TimingR4 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*6to4"

group Timing(source src : TimingR6, target tgt : TimingR4) extends BackboneElement <<type+>> {
  src.event -> tgt.event;
  src.repeat as s -> tgt.repeat as t then TimingRepeat(s, t);
