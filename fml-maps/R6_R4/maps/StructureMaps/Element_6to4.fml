/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/Element6to4'
/// name = 'Element6to4'
/// title = 'Element Transforms: R6 to R4'
/// status = 'draft'

// Generated by reversing Element_4to6.fml. R6-only elements of this type have no R4 place.
uses "http://hl7.org/fhir/6.0/StructureDefinition/Element" alias ElementR6 as source
uses "http://hl7.org/fhir/4.0/StructureDefinition/Element" alias ElementR4 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*6to4"


group Element(source src : ElementR6, target tgt : ElementR4) {
  src.id -> tgt.id;
  src.extension where (url.startsWith('http://hl7.org/fhir/5.0/StructureDefinition/extension-').not()) -> tgt.extension;
}
