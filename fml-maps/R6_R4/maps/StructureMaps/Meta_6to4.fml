/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/Meta6to4'
/// name = 'Meta6to4'
/// title = 'Meta Transforms: R6 to R4'
/// status = 'draft'

// Generated by reversing Meta_4to6.fml. R6-only elements of this type have no R4 place.
uses "http://hl7.org/fhir/6.0/StructureDefinition/Meta" alias MetaR6 as source
uses "http://hl7.org/fhir/4.0/StructureDefinition/Meta" alias MetaR4 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*6to4"


group Meta(source src : MetaR6, target tgt : MetaR4) extends Element <<type+>> {
  src.versionId -> tgt.versionId;
  src.lastUpdated -> tgt.lastUpdated;
  src.source -> tgt.source;
  src.profile -> tgt.profile;
  src.security -> tgt.security;
  src.tag -> tgt.tag;
}
