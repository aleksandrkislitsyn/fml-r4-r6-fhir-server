/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/Observation4to6'
/// name = 'Observation4to6'
/// title = 'Observation Transforms: R4 to R6'
/// status = 'draft'

uses "http://hl7.org/fhir/4.0/StructureDefinition/Observation" alias ObservationR4 as source
uses "http://hl7.org/fhir/6.0/StructureDefinition/Observation" alias ObservationR6 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*4to6"

group Observation(source src : ObservationR4, target tgt : ObservationR6) extends DomainResource <<type+>> {
  src.identifier -> tgt.identifier;
  src.basedOn -> tgt.basedOn; // Warning: Source TargetProfile unsupported: ImmunizationRecommendation  (CarePlan,DeviceRequest,ImmunizationRecommendation,MedicationRequest,NutritionOrder,ServiceRequest -> CarePlan,DeviceRequest,MedicationRequest,NutritionOrder,ServiceRequest)
  src.partOf -> tgt.partOf;
  src.status -> tgt.status;
  src.category -> tgt.category;
  src.code -> tgt.code;
  src.subject -> tgt.subject;
  src.focus -> tgt.focus;
  src.encounter -> tgt.encounter;
  src.effective -> tgt.effective;
  src.issued -> tgt.issued;
  src.performer -> tgt.performer;
  src.value -> tgt.value;
  src.dataAbsentReason -> tgt.dataAbsentReason;
  src.interpretation -> tgt.interpretation;
  src.note -> tgt.note;
  src.bodySite as s where (coding.exists() or text.exists() or id.exists() or extension.where(url != 'http://hl7.org/fhir/StructureDefinition/bodySite').exists()) -> tgt.bodySite as t then ObservationBodySite(s, t);
  src.bodySite as b then {
    b.extension as e where (url = 'http://hl7.org/fhir/StructureDefinition/bodySite') then {
      e.value : Reference as r -> tgt.bodyStructure as cr, cr.reference as t then BodySiteReference(r, t);
    };
  };
  src.method -> tgt.method;
  src.specimen -> tgt.specimen;
  src.device -> tgt.device;
  src.referenceRange as s -> tgt.referenceRange as t then ObservationReferenceRange(s, t);
  src.hasMember -> tgt.hasMember; // Warning: Source TargetProfile unsupported: MolecularSequence  (Observation,QuestionnaireResponse,MolecularSequence -> Observation,QuestionnaireResponse)
  src.derivedFrom -> tgt.derivedFrom; // Warning: Source TargetProfile unsupported: Media,MolecularSequence  (DocumentReference,ImagingStudy,Media,QuestionnaireResponse,Observation,MolecularSequence -> DocumentReference,ImagingStudy,ImagingSelection,QuestionnaireResponse,Observation)
  src.component as s -> tgt.component as t then ObservationComponent(s, t);

  // R6-only elements, written by Observation_6to4. DomainResource keeps these extensions out of the result.
  src.extension as e where (url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-Observation.statusReason') then {
    e.value : CodeableConcept as v -> tgt.statusReason as t then CodeableConcept(v, t);
  };
  src.extension as e where (url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-Observation.organizer') then {
    e.value : boolean as v -> tgt.organizer as t then Boolean(v, t);
  };
  src.extension as e where (url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-Observation.value') then {
    e.value : Attachment as v -> tgt.valueAttachment as t then Attachment(v, t);
  };
  src.extension as e where (url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-Observation.triggeredBy') -> tgt.triggeredBy as t then ObservationTriggeredBy(e, t);
  src.extension as e where (url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-Observation.context') -> tgt.context as t then CodeableReferenceValue(e, t);
  src.extension as e where (url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-Observation.supportingDevice') -> tgt.supportingDevice as t then CodeableReferenceValue(e, t);
}


group ObservationTriggeredBy(source e, target t) {
  e.extension as i where (url = 'observation') then {
    i.value : Reference as v -> t.observation as o then Reference(v, o);
  };
  e.extension as i where (url = 'type') then {
    i.value : code as v -> t.type as o then Code(v, o);
  };
  e.extension as i where (url = 'reason') then {
    i.value : string as v -> t.reason as o then String(v, o);
  };
}


group CodeableReferenceValue(source e, target t) {
  e.value : CodeableConcept as v -> t.concept as o then CodeableConcept(v, o);
  e.value : Reference as v -> t.reference as o then Reference(v, o);
}


// The bodySite extension becomes bodyStructure, so it isn't copied here.
group ObservationBodySite(source src, target tgt) {
  src.id -> tgt.id;
  src.extension where (url != 'http://hl7.org/fhir/StructureDefinition/bodySite') -> tgt.extension;
  src.coding -> tgt.coding;
  src.text -> tgt.text;
}


// These two don't extend BackboneElement, which would copy our extensions onto the R6 element.
group ObservationReferenceRange(source src, target tgt) {
  src.id -> tgt.id;
  src.extension where (url.startsWith('http://hl7.org/fhir/6.0/StructureDefinition/extension-Observation.').not()) -> tgt.extension;
  src.modifierExtension -> tgt.modifierExtension;
  src.extension as e where (url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-Observation.referenceRange.normalValue') then {
    e.value : CodeableConcept as v -> tgt.normalValue as t then CodeableConcept(v, t);
  };
  src.low -> tgt.low;
  src.high -> tgt.high;
  src.type -> tgt.type;
  src.appliesTo -> tgt.appliesTo;
  src.age -> tgt.age;
  src.text -> tgt.text;
}


group ObservationComponent(source src, target tgt) {
  src.id -> tgt.id;
  src.extension where (url.startsWith('http://hl7.org/fhir/6.0/StructureDefinition/extension-Observation.').not()) -> tgt.extension;
  src.modifierExtension -> tgt.modifierExtension;
  src.extension as e where (url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-Observation.component.value') then {
    e.value : Attachment as v -> tgt.valueAttachment as t then Attachment(v, t);
  };
  src.code -> tgt.code;
  src.value -> tgt.value;
  src.dataAbsentReason -> tgt.dataAbsentReason;
  src.interpretation -> tgt.interpretation;
  src.referenceRange as s -> tgt.referenceRange as t then ObservationReferenceRange(s, t);
}
