{
  "name": "fml-r4-r6-fhir-server",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "setup:fml": "bun scripts/setup-fml.ts",
    "dev": "bun run setup:fml && bun --watch src/index.ts",
    "start": "bun run setup:fml && bun src/index.ts",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "bun src/db/index.ts",
    "generate-types": "bun run scripts/generate-types.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun run setup:fml && bun test"
  },
  "dependencies": {
    "@atomic-ehr/fhir-canonical-manager": "^0.0.29",
    "@atomic-ehr/fhirschema": "^0.0.14"
  },
  "devDependencies": {
    "@atomic-ehr/codegen": "^0.0.24",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
